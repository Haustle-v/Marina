+class OBStoreClientTest : public StoreClientTestBase {
+ public:
+  OBStoreClientTest() {
+    // Keep the dataset small to speed up OB integration tests.
+    key_count_ = 200;
+    index_count_ = 20;
+    wait_pending_timeout_ = std::chrono::milliseconds(20000);
+  }
