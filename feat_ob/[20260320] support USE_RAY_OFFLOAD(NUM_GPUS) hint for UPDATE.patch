From 8f124aaa41dc1b50c901c3f2e682bb6ba1b29a8d Mon Sep 17 00:00:00 2001
From: He Su <yefengshuo.yfs@oceanbase.com>
Date: Fri, 20 Mar 2026 17:01:26 +0800
Subject: [PATCH 7/7] [backfill()] support UPDATE /*+ USE_RAY_OFFLOAD(NUM_GPUS)
 */

---
 src/sql/code_generator/ob_static_engine_cg.cpp |  2 ++
 src/sql/engine/table/ob_table_scan_op.cpp      | 12 ++++++++++--
 src/sql/engine/table/ob_table_scan_op.h        |  1 +
 src/sql/parser/sql_parser_mysql_mode.y         |  4 ++++
 src/sql/resolver/dml/ob_dml_resolver.cpp       |  7 +++++++
 src/sql/resolver/dml/ob_hint.cpp               | 12 +++++++++++-
 src/sql/resolver/dml/ob_hint.h                 |  4 +++-
 7 files changed, 38 insertions(+), 4 deletions(-)

diff --git a/src/sql/code_generator/ob_static_engine_cg.cpp b/src/sql/code_generator/ob_static_engine_cg.cpp
index 2ae0fb2b98de..ddb5a42bd922 100644
--- a/src/sql/code_generator/ob_static_engine_cg.cpp
+++ b/src/sql/code_generator/ob_static_engine_cg.cpp
@@ -5827,6 +5827,8 @@ int ObStaticEngineCG::generate_normal_tsc(ObLogTableScan &op, ObTableScanSpec &s
     spec.frozen_version_ = op.get_plan()->get_optimizer_context().get_global_hint().frozen_version_;
     spec.force_refresh_lc_ = op.get_plan()->get_optimizer_context().get_global_hint().force_refresh_lc_;
     spec.use_ray_offload_ = op.get_plan()->get_optimizer_context().get_global_hint().use_ray_offload_;
+    spec.use_ray_offload_num_gpus_ =
+        op.get_plan()->get_optimizer_context().get_global_hint().use_ray_offload_num_gpus_;
     spec.use_dist_das_ = op.use_das();
     spec.batch_scan_flag_ = op.use_batch();
     spec.table_row_count_ = op.get_table_row_count();
diff --git a/src/sql/engine/table/ob_table_scan_op.cpp b/src/sql/engine/table/ob_table_scan_op.cpp
index 7466386e8d38..2a218f714a15 100644
--- a/src/sql/engine/table/ob_table_scan_op.cpp
+++ b/src/sql/engine/table/ob_table_scan_op.cpp
@@ -666,6 +666,7 @@ ObTableScanSpec::ObTableScanSpec(ObIAllocator &alloc, const ObPhyOperatorType ty
     pdml_partition_id_(NULL),
     agent_vt_meta_(alloc),
     flags_(0),
+    use_ray_offload_num_gpus_(0),
     tenant_id_col_idx_(0),
     partition_id_calc_type_(0),
     parser_name_(),
@@ -704,7 +705,8 @@ OB_SERIALIZE_MEMBER((ObTableScanSpec, ObOpSpec),
                     parser_properties_,
                     pseudo_column_exprs_,
                     lob_inrow_threshold_,
-                    lake_table_format_);
+                    lake_table_format_,
+                    use_ray_offload_num_gpus_);
 
 DEF_TO_STRING(ObTableScanSpec)
 {
@@ -726,6 +728,7 @@ DEF_TO_STRING(ObTableScanSpec)
        K(batch_scan_flag_),
        K(use_dist_das_),
        K(use_ray_offload_),
+       K(use_ray_offload_num_gpus_),
        K(tsc_ctdef_),
        K(report_col_checksum_),
        K_(agent_vt_meta),
@@ -3936,7 +3939,12 @@ int ObTableScanOp::offload_to_ray(const ExprFixedArray &storage_output,
       const int64_t ray_import_init_elapsed_ms = ObTimeUtility::current_time_ms() - ray_import_init_start_ms;
       FLOG_INFO("-- Time: ray import and init elapsed (ms)", K(ray_import_init_elapsed_ms));
       const int64_t t1 = ObTimeUtility::current_time_ms();
-      py::object remote_func = ray.attr("remote")(udf_func);
+      py::object remote_func;
+      if (MY_SPEC.use_ray_offload_num_gpus_ > 0) {
+        remote_func = ray.attr("remote")(py::arg("num_gpus") = static_cast<int>(MY_SPEC.use_ray_offload_num_gpus_))(udf_func);
+      } else {
+        remote_func = ray.attr("remote")(udf_func);
+      }
       const int64_t t2 = ObTimeUtility::current_time_ms();
       py::object object_ref = remote_func.attr("remote")(*args);
       const int64_t t3 = ObTimeUtility::current_time_ms();
diff --git a/src/sql/engine/table/ob_table_scan_op.h b/src/sql/engine/table/ob_table_scan_op.h
index d2346b344584..3df2017f586f 100644
--- a/src/sql/engine/table/ob_table_scan_op.h
+++ b/src/sql/engine/table/ob_table_scan_op.h
@@ -501,6 +501,7 @@ public:
       uint64_t reserved_                        : 46;
     };
   };
+  int64_t use_ray_offload_num_gpus_;
   int64_t tenant_id_col_idx_;
   int64_t partition_id_calc_type_;
 
diff --git a/src/sql/parser/sql_parser_mysql_mode.y b/src/sql/parser/sql_parser_mysql_mode.y
index 12b58b362cdb..22b48979bb3f 100644
--- a/src/sql/parser/sql_parser_mysql_mode.y
+++ b/src/sql/parser/sql_parser_mysql_mode.y
@@ -12529,6 +12529,10 @@ READ_CONSISTENCY '(' consistency_level ')'
   malloc_terminal_node($$, result->malloc_pool_, T_USE_PLAN_CACHE);
   $$->value_ = $3[0];
 }
+| USE_RAY_OFFLOAD '(' INTNUM ')'
+{
+  malloc_non_terminal_node($$, result->malloc_pool_, T_USE_RAY_OFFLOAD, 1, $3);
+}
 | USE_RAY_OFFLOAD
 {
   malloc_terminal_node($$, result->malloc_pool_, T_USE_RAY_OFFLOAD);
diff --git a/src/sql/resolver/dml/ob_dml_resolver.cpp b/src/sql/resolver/dml/ob_dml_resolver.cpp
index c2f531c7e551..38f4dae6b8fc 100755
--- a/src/sql/resolver/dml/ob_dml_resolver.cpp
+++ b/src/sql/resolver/dml/ob_dml_resolver.cpp
@@ -16381,6 +16381,13 @@ int ObDMLResolver::resolve_global_hint(const ParseNode &hint_node,
     }
     case T_USE_RAY_OFFLOAD: {
       global_hint.use_ray_offload_ = true;
+      if (0 == hint_node.num_child_) {
+        global_hint.use_ray_offload_num_gpus_ = 0;
+      } else {
+        CHECK_HINT_PARAM(hint_node, 1) {
+          global_hint.use_ray_offload_num_gpus_ = child0->value_;
+        }
+      }
       break;
     }
     case T_USE_PLAN_CACHE: {
diff --git a/src/sql/resolver/dml/ob_hint.cpp b/src/sql/resolver/dml/ob_hint.cpp
index 6bf2fd2784a9..9cd1d39eb9d6 100644
--- a/src/sql/resolver/dml/ob_hint.cpp
+++ b/src/sql/resolver/dml/ob_hint.cpp
@@ -365,6 +365,7 @@ void ObGlobalHint::reset()
   enable_lock_early_release_ = false;
   force_refresh_lc_ = false;
   use_ray_offload_ = false;
+  use_ray_offload_num_gpus_ = 0;
   log_level_.reset();
   parallel_ = UNSET_PARALLEL;
   dml_parallel_ = UNSET_PARALLEL;
@@ -404,6 +405,11 @@ int ObGlobalHint::merge_global_hint(const ObGlobalHint &other)
   enable_lock_early_release_ |= other.enable_lock_early_release_;
   force_refresh_lc_ |= other.force_refresh_lc_;
   use_ray_offload_ |= other.use_ray_offload_;
+  if (other.use_ray_offload_) {
+    use_ray_offload_num_gpus_ = use_ray_offload_num_gpus_ > other.use_ray_offload_num_gpus_
+        ? use_ray_offload_num_gpus_
+        : other.use_ray_offload_num_gpus_;
+  }
   merge_plan_cache_hint(other.plan_cache_policy_);
   merge_parallel_dml_hint(other.pdml_option_);
   force_trace_log_ |= other.force_trace_log_;
@@ -520,7 +526,11 @@ int ObGlobalHint::print_global_hint(PlanText &plan_text) const
     } else { }
   }
   if (OB_SUCC(ret) && use_ray_offload_) { //USE_RAY_OFFLOAD
-    PRINT_GLOBAL_HINT_STR("USE_RAY_OFFLOAD");
+    if (0 == use_ray_offload_num_gpus_) {
+      PRINT_GLOBAL_HINT_STR("USE_RAY_OFFLOAD");
+    } else if (OB_FAIL(BUF_PRINTF("%sUSE_RAY_OFFLOAD(%ld)", outline_indent, use_ray_offload_num_gpus_))) {
+      LOG_WARN("failed to print USE_RAY_OFFLOAD hint", K(ret));
+    }
   }
   if (OB_SUCC(ret) && force_trace_log_) { //TRACE_LOG
     PRINT_GLOBAL_HINT_STR("TRACE_LOG");
diff --git a/src/sql/resolver/dml/ob_hint.h b/src/sql/resolver/dml/ob_hint.h
index 2a28c06d5a22..5a6dccac25e2 100644
--- a/src/sql/resolver/dml/ob_hint.h
+++ b/src/sql/resolver/dml/ob_hint.h
@@ -552,7 +552,8 @@ struct ObGlobalHint {
                K_(px_node_hint),
                K_(disable_op_rich_format_hint),
                K_(trigger_hint),
-               K_(use_ray_offload));
+               K_(use_ray_offload),
+               K_(use_ray_offload_num_gpus));
 
   int64_t frozen_version_;
   int64_t topk_precision_;
@@ -565,6 +566,7 @@ struct ObGlobalHint {
   bool enable_lock_early_release_;
   bool force_refresh_lc_;
   bool use_ray_offload_;
+  int64_t use_ray_offload_num_gpus_;
   common::ObString log_level_;
   int64_t parallel_;
   int64_t dml_parallel_;
-- 
2.17.0

