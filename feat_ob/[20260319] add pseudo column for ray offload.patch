+int ObServer::init_py_env()
+{
+  int ret = OB_SUCCESS;
+  if (!Py_IsInitialized()) {
+    // python3 -c "import sys; print(sys.prefix)"
+    const std::wstring py_home_base = L"/home/yefengshuo.yfs/anaconda3/envs/ray_env_python313";
+    // python3 -c "import sysconfig; print(sysconfig.get_path('stdlib'))"
+    const std::wstring py_stdlib_base = L"/home/yefengshuo.yfs/anaconda3/envs/ray_env_python313/lib/python3.13";
+    const std::wstring py_executable = py_home_base + L"/bin/python3";
+    const std::wstring py_dynload = py_stdlib_base + L"/lib-dynload";
+    const std::wstring py_site = py_stdlib_base + L"/site-packages";
+
+    const wchar_t *const py_home_w = py_home_base.c_str();
+    const wchar_t *const py_executable_w = py_executable.c_str();
+    const wchar_t *const py_stdlib_w = py_stdlib_base.c_str();
+    const wchar_t *const py_dynload_w = py_dynload.c_str();
+    const wchar_t *const py_site_w = py_site.c_str();
+
+    PyStatus status;
+    PyConfig config;
+    PyConfig_InitPythonConfig(&config);
+    config.user_site_directory = 0;
+    config.module_search_paths_set = 1;
+
+    status = PyConfig_SetString(&config, &config.home, py_home_w);
+    if (!PyStatus_Exception(status)) {
+      status = PyConfig_SetString(&config, &config.executable, py_executable_w);
+    }
+    if (!PyStatus_Exception(status)) {
+      status = PyWideStringList_Append(&config.module_search_paths, py_stdlib_w);
+    }
+    if (!PyStatus_Exception(status)) {
+      status = PyWideStringList_Append(&config.module_search_paths, py_dynload_w);
+    }
+    if (!PyStatus_Exception(status)) {
+      status = PyWideStringList_Append(&config.module_search_paths, py_site_w);
+    }
+    if (!PyStatus_Exception(status)) {
+      status = Py_InitializeFromConfig(&config);
+    }
+    if (PyStatus_Exception(status)) {
+      ret = OB_ERR_UNEXPECTED;
+      FLOG_WARN("failed to initialize python from config", KR(ret), "status_error", status.err_msg);
+      return ret;
+    } else {
+      FLOG_INFO("ray offload python env initialized",
+                K(py_home_base.c_str()), K(py_stdlib_base.c_str()),
+                K(py_executable.c_str()), K(py_dynload.c_str()), K(py_site.c_str()));
+    }
+    PyConfig_Clear(&config);
+  }
+
+  // dump python runtime info, to see if Python environment is initialized correctly
+  try {
+    pybind11::module_ sys = pybind11::module_::import("sys");
+    const std::string py_executable = pybind11::str(sys.attr("executable"));
+    const std::string py_prefix = pybind11::str(sys.attr("prefix"));
+    const std::string py_version = pybind11::str(sys.attr("version"));
+    const std::string py_path = pybind11::str(sys.attr("path"));
+    FLOG_INFO("ray offload python runtime",
+              K(py_executable.c_str()), K(py_prefix.c_str()),
+              K(py_version.c_str()), K(py_path.c_str()));
+    std::string pybind_module_file("N/A");
+    pybind11::module_ pybind_mod = pybind11::module_::import("pybind11");
+    if (pybind11::hasattr(pybind_mod, "__file__")) {
+      pybind_module_file = pybind11::str(pybind_mod.attr("__file__"));
+    }
+    FLOG_INFO("ray offload pybind11 module location", K(pybind_module_file.c_str()));
+  } catch (const std::exception &e) {
+    FLOG_WARN("dump python runtime info failed", "err", e.what());
+  }
+
+  // Py_InitializeFromConfig() leaves this thread holding the GIL; PyEval_SaveThread() is used to release (and save) the GIL; 
+  // so that other threads (e.g. worker threads for ray offload) can acquire it.
+  if (OB_SUCC(ret) && Py_IsInitialized()) {
+    main_thread_py_state_ = PyEval_SaveThread();
+  }
+
+  return ret;
+}
+
+int ObServer::init_ray()
+{
+  int ret = OB_SUCCESS;
+  if (!Py_IsInitialized()) {
+    ret = OB_ERR_UNEXPECTED;
+    LOG_WARN("python not initialized, cannot init ray", KR(ret));
+    return ret;
+  }
+  try {
+    // pybind11::gil_scoped_acquire gil;  // no need to acquire GIL here, because the main thread already holds the GIL
+    pybind11::module_ ray = pybind11::module_::import("ray");
+    if (!pybind11::cast<bool>(ray.attr("is_initialized")())) {
+      ray.attr("init")(pybind11::arg("num_cpus") = 4,
+                       pybind11::arg("num_gpus") = 0,
+                       pybind11::arg("include_dashboard") = true);
+      FLOG_INFO("ray.init() done at observer startup");
+    } else {
+      FLOG_INFO("ray already initialized, skip ray.init()");
+    }
+  } catch (const pybind11::error_already_set &e) {
+    ret = OB_ERR_UNEXPECTED;
+    LOG_WARN("init ray failed", KR(ret), "python_err", e.what());
+  } catch (const std::exception &e) {
+    ret = OB_ERR_UNEXPECTED;
+    LOG_WARN("init ray failed", KR(ret), "err", e.what());
+  }
+
+  // Py_InitializeFromConfig() leaves this thread holding the GIL; PyEval_SaveThread() is used to release (and save) the GIL; 
+  // so that other threads (e.g. worker threads for ray offload) can acquire it.
+  if (OB_SUCC(ret) && Py_IsInitialized()) {
+    main_thread_py_state_ = PyEval_SaveThread();
+  }
+
+  return ret;
+}
+
+void ObServer::shutdown_ray()
+{
+  if (!Py_IsInitialized()) {
+    return;
+  }
+  try {
+    pybind11::gil_scoped_acquire gil;
+    pybind11::module_ ray = pybind11::module_::import("ray");
+    if (pybind11::cast<bool>(ray.attr("is_initialized")())) {
+      ray.attr("shutdown")();
+      FLOG_INFO("ray.shutdown() done");
+    }
+  } catch (const pybind11::error_already_set &e) {
+    int ret = OB_ERR_UNEXPECTED;
+    FLOG_WARN("ray.shutdown() failed", KR(ret), "python_err", e.what());
+  } catch (const std::exception &e) {
+    int ret = OB_ERR_UNEXPECTED;
+    FLOG_WARN("ray.shutdown() failed", KR(ret), "err", e.what());
+  }
+}
+
+void ObServer::finalize_py_env()
+{
+  if (Py_IsInitialized()) {
+    // Restore main thread state so this thread holds the GIL before finalize
+    if (main_thread_py_state_ != nullptr) {
+      PyEval_RestoreThread(main_thread_py_state_);
+      main_thread_py_state_ = nullptr;
+    }
+    if (Py_FinalizeEx() != 0) {
+      int ret = OB_ERR_UNEXPECTED;
+      FLOG_WARN("Py_FinalizeEx() failed", KR(ret));
+    }
+  }
+}
