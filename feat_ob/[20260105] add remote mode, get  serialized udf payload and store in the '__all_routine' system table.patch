@@ -1356,22 +1358,24 @@ int ObCreateRoutineResolver::resolve_external_udf(const ParseNode &parse_tree,
             udf_type = value.trim();
           } else if (0 == key.case_compare(file_key)) {
             file = value.trim();
+          } else if (0 == key.case_compare(mode_key)) {
+            mode = value.trim();
           }
         }
       }
 
       if (OB_FAIL(ret)) {
         // do noting
-      } else if (entry_name.empty() || udf_type.empty() || file.empty()) {
+      } else if (entry_name.empty() || udf_type.empty() || file.empty() || mode.empty()) {
         ret = OB_INVALID_ARGUMENT;
-        LOG_WARN("invalid argument to create external UDF", K(ret), K(entry_name), K(udf_type), K(file));
+        LOG_WARN("invalid argument to create external UDF", K(ret), K(entry_name), K(udf_type), K(file), K(mode));
       } else if (OB_FAIL(routine_info.set_external_routine_entry(entry_name))) {
         LOG_WARN("failed to set external routine entry", K(ret), K(entry_name));
-      } else if (OB_FAIL(resolve_external_routine_type(udf_type, file, routine_info))) {
-        LOG_WARN("failed to resolve external routine type", K(ret), K(udf_type), K(file), K(routine_info));
+      } else if (OB_FAIL(resolve_external_routine_type(udf_type, file, mode, routine_info))) {
+        LOG_WARN("failed to resolve external routine type", K(ret), K(udf_type), K(file), K(mode), K(routine_info));
       }
 
-      LOG_INFO("finished to resolve external UDF", K(ret), K(entry_name), K(udf_type), K(file), K(routine_info));
+      LOG_INFO("finished to resolve external UDF", K(ret), K(entry_name), K(udf_type), K(file), K(mode), (routine_info));
     } else {
       ret = OB_ERR_UNEXPECTED;
       LOG_WARN("unexpected parse_tree of external UDF",
@@ -1399,6 +1403,7 @@ int ObCreateRoutineResolver::resolve_external_udf(const ParseNode &parse_tree,
 
 int ObCreateRoutineResolver::resolve_external_routine_type(const ObString &udf_type,
                                                            const ObString &file,
+                                                           const ObString &mode,
                                                            ObRoutineInfo &routine_info)
 {
   int ret = OB_SUCCESS;
@@ -1410,6 +1415,7 @@ int ObCreateRoutineResolver::resolve_external_routine_type(const ObString &udf_t
   const ObString udtf_type = "UdtfJar";
 
   const ObString py_type = "Python";
+  const ObString remote_mode = "remote";
 
   bool is_udf = false;
   bool is_udaf = false;
@@ -1432,6 +1438,11 @@ int ObCreateRoutineResolver::resolve_external_routine_type(const ObString &udf_t
     LOG_USER_ERROR(OB_NOT_SUPPORTED, "udf type");
   }
 
+  if (0 == mode.case_compare(remote_mode)) {
+    routine_info.set_is_remote();
+    routine_info.set_serialization_format("cloudpickle");
+  } 
+
   if (OB_FAIL(ret)) {
     // do nothing
   } else if (file.prefix_match_ci("http://") || file.prefix_match_ci("https://") || file.prefix_match_ci("file://")) {
diff --git a/src/sql/resolver/ddl/ob_create_routine_resolver.h b/src/sql/resolver/ddl/ob_create_routine_resolver.h
