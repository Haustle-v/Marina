 7 files changed, 76 insertions(+), 21 deletions(-)

diff --git a/deps/oblib/src/lib/ob_define.h b/deps/oblib/src/lib/ob_define.h
index 808cb75633e2..2716fa06c484 100644
--- a/deps/oblib/src/lib/ob_define.h
+++ b/deps/oblib/src/lib/ob_define.h
@@ -327,6 +327,7 @@ const int64_t OB_MAX_CONSTRAINT_NAME_LENGTH_MYSQL = 64; // Compatible with mysql
 const int64_t OB_MAX_CONSTRAINT_EXPR_LENGTH = 2048;
 const int64_t OB_MAX_TABLESPACE_NAME_LENGTH = 128;
 const int64_t OB_MAX_UDF_NAME_LENGTH = 64;
+const int64_t OB_MAX_UDF_PAYLOAD_SIZE = 16 * 1024L;
 const int64_t OB_MAX_ASH_PL_NAME_LENGTH = 32;
 const int64_t OB_MAX_DL_NAME_LENGTH = 128;
 const int64_t OB_MAX_USER_NAME_LENGTH = 64; // Not compatible with Oracle (Oracle is 128), the logic is greater than when an error is reported
diff --git a/src/share/inner_table/ob_inner_table_schema_def.py b/src/share/inner_table/ob_inner_table_schema_def.py
index 4227b3d26c62..d0e5a8790f04 100755
--- a/src/share/inner_table/ob_inner_table_schema_def.py
+++ b/src/share/inner_table/ob_inner_table_schema_def.py
@@ -1608,6 +1608,9 @@ all_routine_def = dict(
       ('external_routine_entry', 'varchar:OB_MAX_MYSQL_VARCHAR_LENGTH', 'true'),
       ('external_routine_url', 'varchar:OB_MAX_MYSQL_VARCHAR_LENGTH', 'true'),
       ('external_routine_resource', 'varchar:OB_MAX_MYSQL_VARCHAR_LENGTH', 'true'),
+      ('remote_mode', 'bool', 'true', 'false'),
+      ('serialization_payload', 'varbinary:OB_MAX_UDF_PAYLOAD_SIZE', 'true'),
+      ('serialization_format', 'varchar:32', 'true'),
     ],
 )
 
diff --git a/src/share/schema/ob_routine_info.h b/src/share/schema/ob_routine_info.h
index e85041457fee..5d6af48d7053 100644
--- a/src/share/schema/ob_routine_info.h
+++ b/src/share/schema/ob_routine_info.h
@@ -88,6 +88,7 @@ enum ObRoutineFlag
   SP_FLAG_EXTERNAL_STATE = SP_FLAG_HAS_OUT_PARAM * 2,
   SP_FLAG_MYSQL_UDTF = SP_FLAG_EXTERNAL_STATE * 2,
   SP_FLAG_SQL_TRANSPILER_ELIGIBLE = SP_FLAG_MYSQL_UDTF * 2,
+  SP_FLAG_REMOTE = SP_FLAG_SQL_TRANSPILER_ELIGIBLE * 2,
 };
 
 namespace oceanbase
@@ -642,6 +643,11 @@ public:
     return SP_FLAG_SQL_TRANSPILER_ELIGIBLE == (flag_ & SP_FLAG_SQL_TRANSPILER_ELIGIBLE);
   }
 
+  OB_INLINE void set_is_remote() { flag_ |= SP_FLAG_REMOTE; }
+  OB_INLINE bool is_remote() const { return SP_FLAG_REMOTE == (flag_ & SP_FLAG_REMOTE); }
+  OB_INLINE void set_serialization_format(const common::ObString &format) { return deep_copy_str(format, serialization_format_); }
+  OB_INLINE const common::ObString &get_serialization_format() const { return serialization_format_; }
+
   TO_STRING_KV(K_(tenant_id),
                K_(database_id),
                K_(package_id),
@@ -695,6 +701,8 @@ private:
   common::ObString external_routine_entry_;      // entry point of external routine, class name for Java UDF
   common::ObString external_routine_url_;        // URL of external routine
   common::ObString external_routine_resource_;   // resource name of external routine
+  common::ObString serialization_format_;          // serialization format of external routine
+  common::ObString serialization_checksum_;        // serialization checksum of external routine
 };
 }  // namespace schema
 }  // namespace share
diff --git a/src/share/schema/ob_routine_sql_service.cpp b/src/share/schema/ob_routine_sql_service.cpp
index eb228acc8e08..3a1624a39e42 100644
--- a/src/share/schema/ob_routine_sql_service.cpp
+++ b/src/share/schema/ob_routine_sql_service.cpp
@@ -13,6 +13,9 @@
 #define USING_LOG_PREFIX SHARE_SCHEMA
 #include "ob_routine_sql_service.h"
 #include "pl/ob_pl_stmt.h"
+#include "pl/external_routine/ob_external_resource.h"
+#include "share/ob_encryption_util.h"
+#include "lib/string/ob_sql_string.h"
 
 namespace oceanbase
 {
@@ -506,16 +509,41 @@ int ObRoutineSqlService::gen_routine_dml(
 
   if (OB_SUCC(ret)) {
     uint64_t data_version = 0;
+    ObSqlString payload_buf;
+    ObString serialization_payload;
 
     if (OB_FAIL(GET_MIN_DATA_VERSION(exec_tenant_id, data_version))) {
       LOG_WARN("failed to GET_MIN_DATA_VERSION", K(ret), K(exec_tenant_id));
     } else if (data_version < DATA_VERSION_4_4_0_0) {
       // do nothing
-    } else if (OB_FAIL(dml.add_column("external_routine_type", static_cast<int64_t>(routine_info.get_external_routine_type())))
-        || OB_FAIL(dml.add_column("external_routine_entry", ObHexEscapeSqlStr(routine_info.get_external_routine_entry())))
-        || OB_FAIL(dml.add_column("external_routine_url", ObHexEscapeSqlStr(routine_info.get_external_routine_url())))
-        || OB_FAIL(dml.add_column("external_routine_resource", ObHexEscapeSqlStr(routine_info.get_external_routine_resource())))) {
-      LOG_WARN("add column failed", K(ret));
+    } else {
+      if (routine_info.is_remote()) {
+        if (routine_info.get_external_routine_url().empty()) {
+          ret = OB_INVALID_ARGUMENT;
+          LOG_WARN("external routine url is empty for remote routine", K(ret), K(routine_info));
+        } else if (OB_FAIL(pl::ObExternalURLJar::curl_fetch(routine_info.get_external_routine_url(), payload_buf))) {
+          LOG_WARN("failed to fetch external routine payload", K(ret), "url", routine_info.get_external_routine_url());
+        } else if (payload_buf.length() > OB_MAX_UDF_PAYLOAD_SIZE) {
+          ret = OB_SIZE_OVERFLOW;
+          LOG_WARN("external routine payload too large", K(ret), "payload_size", payload_buf.length(),
+                   "payload_limit", OB_MAX_UDF_PAYLOAD_SIZE);
+        } else {
+          serialization_payload.assign_ptr(payload_buf.ptr(), static_cast<int32_t>(payload_buf.length()));
+        }
+      }
+
+      if (OB_FAIL(ret)) {
+        // do nothing
+      } else if (OB_FAIL(dml.add_column("external_routine_type", static_cast<int64_t>(routine_info.get_external_routine_type())))
+          || OB_FAIL(dml.add_column("external_routine_entry", ObHexEscapeSqlStr(routine_info.get_external_routine_entry())))
+          || OB_FAIL(dml.add_column("external_routine_url", ObHexEscapeSqlStr(routine_info.get_external_routine_url())))
+          || OB_FAIL(dml.add_column("external_routine_resource", ObHexEscapeSqlStr(routine_info.get_external_routine_resource())))
+          || OB_FAIL(dml.add_column("remote_mode", routine_info.is_remote()))
+          || (routine_info.is_remote()
+              && OB_FAIL(dml.add_column("serialization_payload", ObHexEscapeSqlStr(serialization_payload))))
+          || OB_FAIL(dml.add_column("serialization_format", ObHexEscapeSqlStr(routine_info.get_serialization_format())))) {
+        LOG_WARN("add column failed", K(ret));
+      }
     }
   }
 
