+int ObTableScanOp::compute_ray_offload_result_for_udf_gen_col()
+{
+  int ret = OB_SUCCESS;
+  const ExprFixedArray &storage_output = MY_CTDEF.get_das_output_exprs();
+  const UIntFixedArray &output_cids = MY_CTDEF.get_das_output_cids();
+  if (OB_UNLIKELY(storage_output.count() != output_cids.count())) {
+    ret = OB_NOT_SUPPORTED;
+    LOG_WARN("storage_output and output_cids count mismatch, may be caused by attach path in the RAY OFFLOAD",
+             K(storage_output.count()), K(output_cids.count()), KP(MY_CTDEF.attach_spec_.attach_ctdef_));
+  }
+
+  if (OB_FAIL(ret)) {
+  } else if (OB_FAIL(get_input_column_idxs_in_storage_output_(output_cids))) {
+    LOG_WARN("failed to get input column idxs in storage output", K(ret), K(MY_SPEC.updated_udf_generated_col_id_));
+  }
+
+  // evaluate the input columns of UDF for current batch
+  if (OB_SUCC(ret)) {
+    for (int64_t n = 0; OB_SUCC(ret) && n < input_column_idxs_in_storage_output_.count(); ++n) {
+      const int64_t idx = input_column_idxs_in_storage_output_.at(n);
+      ObExpr *input_expr = storage_output[idx];
+      if (OB_ISNULL(input_expr)) {
+        ret = OB_ERR_UNEXPECTED;
+        LOG_WARN("input expr is null", K(ret), K(idx));
+      } else if (OB_FAIL(input_expr->eval_batch(eval_ctx_, *brs_.skip_, brs_.size_))) {
+        LOG_WARN("evaluate input expression failed", K(ret), K(idx));
+      }
+    }
+  }
+
+  const int64_t eval_batch_start_ms = ObTimeUtility::current_time_ms();
+  int64_t pseudo_ray_offload_column_idx = -1;
+  for (int64_t i = 0; OB_SUCC(ret) && i < storage_output.count(); ++i) {
+    ObExpr *e = storage_output[i];
+    if (OB_ISNULL(e)) {
+      ret = OB_ERR_UNEXPECTED;
+      LOG_WARN("error unexpected, expr is nullptr", K(ret));
+      break;
+    } else if (T_PSEUDO_RAY_OFFLOAD_COLUMN == e->type_) {
+      pseudo_ray_offload_column_idx = i;
+      break;
+    }
+  }
+  if (OB_SUCC(ret) && pseudo_ray_offload_column_idx >= 0) {
+    ObExpr *e = storage_output[pseudo_ray_offload_column_idx];
+    if (OB_FAIL(e->eval_batch(eval_ctx_, *brs_.skip_, brs_.size_))) {
+      LOG_WARN("evaluate expression failed", K(ret));
+    } else {
+      e->locate_datums_for_update(eval_ctx_, brs_.size_);
+      ObEvalInfo &info = e->get_eval_info(eval_ctx_);
+      info.point_to_frame_ = true;
+      ObDatumVector datum_vector = e->locate_expr_datumvector(eval_ctx_);
+      // 按批卸载
+      if (brs_.size_ > 0) {
+        if (OB_FAIL(offload_to_ray(storage_output, e->obj_meta_.get_type(), datum_vector, brs_.size_, brs_.skip_))) {
+          LOG_WARN("failed to compute ray offload result for batch", K(ret));
+        }
+      }
+      e->set_evaluated_projected(eval_ctx_);
+    }
+  }
+  const int64_t eval_batch_elapsed_ms = ObTimeUtility::current_time_ms() - eval_batch_start_ms;
+  FLOG_INFO("-- Time: eval_batch elapsed (ms)", K(eval_batch_elapsed_ms), K(lbt()));
+
+  return ret;
+}
