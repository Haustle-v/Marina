From 1c762e3334854f94b472a4d0addefdce667b1d83 Mon Sep 17 00:00:00 2001
From: He Su <yefengshuo.yfs@oceanbase.com>
Date: Fri, 27 Mar 2026 17:22:12 +0800
Subject: [PATCH] [add_column()] ALTER TABLE tbl ADD COLUMN col_name sql_type
 AS UDF udf_name

---
 .../parser/non_reserved_keywords_mysql_mode.c |  1 +
 src/sql/parser/sql_parser_mysql_mode.y        | 12 +++++-
 .../resolver/ddl/ob_alter_table_resolver.cpp  | 14 +++----
 src/sql/resolver/ddl/ob_ddl_resolver.cpp      | 42 +++++++++++++++++++
 src/sql/resolver/ddl/ob_ddl_resolver.h        |  1 +
 5 files changed, 61 insertions(+), 9 deletions(-)

diff --git a/src/sql/parser/non_reserved_keywords_mysql_mode.c b/src/sql/parser/non_reserved_keywords_mysql_mode.c
index e5ceab9e3534..bab623f4a119 100644
--- a/src/sql/parser/non_reserved_keywords_mysql_mode.c
+++ b/src/sql/parser/non_reserved_keywords_mysql_mode.c
@@ -1066,6 +1066,7 @@ static const NonReservedKeyword Mysql_none_reserved_keywords[] =
   {"types", TYPES},
   {"to", TO},
   {"top_k_fre_hist", TOP_K_FRE_HIST},
+  {"udf", UDF},
   {"uncommitted", UNCOMMITTED},
   {"unconditional", UNCONDITIONAL},
   {"undefined", UNDEFINED},
diff --git a/src/sql/parser/sql_parser_mysql_mode.y b/src/sql/parser/sql_parser_mysql_mode.y
index eabcebce2ec7..f8b1bed6e8c6 100644
--- a/src/sql/parser/sql_parser_mysql_mode.y
+++ b/src/sql/parser/sql_parser_mysql_mode.y
@@ -372,7 +372,7 @@ END_P SET_VAR DELIMITER
         TABLEGROUP_ID TENANT_ID THROTTLE TIME_ZONE_INFO TOP_K_FRE_HIST TIMES TRIM_SPACE TTL
         TRANSFER TUNNEL_ENDPOINT TENANT_STS_CREDENTIAL TABLETS TIME_UNIT TIME_ZONE
 
-        UNCOMMITTED UNCONDITIONAL UNDEFINED UNDO_BUFFER_SIZE UNDOFILE UNNEST UNICODE UNINSTALL UNIT UNIT_GROUP UNIT_LIST UNIT_NUM UNLOCKED UNTIL
+        UDF UNCOMMITTED UNCONDITIONAL UNDEFINED UNDO_BUFFER_SIZE UNDOFILE UNNEST UNICODE UNINSTALL UNIT UNIT_GROUP UNIT_LIST UNIT_NUM UNLOCKED UNTIL
         UNUSUAL UPGRADE URL USE_BLOOM_FILTER UNKNOWN USE_FRM USER USERNAME USER_RESOURCES UNBOUNDED UP UNLIMITED USER_SPECIFIED URI
 
         VALID VALUE VARIANCE VARIABLES VERBOSE VERIFY VERSION VIEW VISIBLE VIRTUAL_COLUMN_ID VALIDATE VAR_POP
@@ -6254,6 +6254,16 @@ column_definition_ref data_type opt_column_attribute_list opt_column_reference o
   merge_nodes(attributes, result, T_COLUMN_ATTRIBUTES, $10);
   malloc_non_terminal_node($$, result->malloc_pool_, T_COLUMN_DEFINITION, 7, $1, $2, attributes, $7, $9, $12, $4);
 }
+| column_definition_ref data_type opt_collation opt_generated_keyname AS UDF column_definition_ref opt_column_attribute_list opt_column_reference opt_position_column
+{
+  (void)($4);
+  (void)($5);
+  (void)($6);
+  ParseNode *attributes = NULL;
+  set_data_type_collation($2, $3, true, false);
+  merge_nodes(attributes, result, T_COLUMN_ATTRIBUTES, $8);
+  malloc_non_terminal_node($$, result->malloc_pool_, T_COLUMN_DEFINITION, 6, $1, $2, attributes, $7, $9, $10);
+}
 | column_definition_ref SERIAL opt_column_attribute_list opt_position_column 
 {
   ParseNode *unsigned_bigint_type = NULL;
diff --git a/src/sql/resolver/ddl/ob_alter_table_resolver.cpp b/src/sql/resolver/ddl/ob_alter_table_resolver.cpp
index 206ea78ceaf1..bab07f0ef6c9 100644
--- a/src/sql/resolver/ddl/ob_alter_table_resolver.cpp
+++ b/src/sql/resolver/ddl/ob_alter_table_resolver.cpp
@@ -6601,15 +6601,11 @@ int ObAlterTableResolver::resolve_alter_table_column_definition(AlterColumnSchem
       }
     }
 
-    // For UDF generated columns, set cur_default_value to NULL placeholder so that:
-    // the StaticEngineCg for the expr and expression evaluation in shadow table stay simple.
     if (OB_SUCC(ret)) {
-      ObObj udf_default_value;
-      udf_default_value.set_varchar(ObString::make_string("NULL"));
-      udf_default_value.set_collation_type(ObCharset::get_system_collation());
-      udf_default_value.set_collation_level(CS_LEVEL_COERCIBLE);
-      if (OB_FAIL(column.set_cur_default_value(udf_default_value, false))) {
-        LOG_WARN("failed to set cur_default_value", K(ret));
+      ObObj null_default;
+      null_default.set_null();
+      if (OB_FAIL(column.set_cur_default_value(null_default, false))) {
+        LOG_WARN("failed to clear cur_default_value for udf-backed column", K(ret));
       }
     }
   } 
@@ -6628,6 +6624,8 @@ int ObAlterTableResolver::resolve_alter_table_column_definition(AlterColumnSchem
       if (OB_UNLIKELY(GEN_COLUMN_DEFINITION_NUM_CHILD == node->num_child_)) {
       // generated column with pos_column
         pos_node = node->children_[5];
+      } else if (OB_UNLIKELY(UDF_BACKED_COLUMN_DEFINITION_NUM_CHILD == node->num_child_)) {
+        pos_node = node->children_[5];
       } else {
         // normal column with pos_column
         pos_node = node->children_[3];
diff --git a/src/sql/resolver/ddl/ob_ddl_resolver.cpp b/src/sql/resolver/ddl/ob_ddl_resolver.cpp
index d293cf3659eb..7541700a9c66 100644
--- a/src/sql/resolver/ddl/ob_ddl_resolver.cpp
+++ b/src/sql/resolver/ddl/ob_ddl_resolver.cpp
@@ -3792,6 +3792,46 @@ int ObDDLResolver::resolve_column_definition(ObColumnSchemaV2 &column,
           }
         }
       }
+    } else if (UDF_BACKED_COLUMN_DEFINITION_NUM_CHILD == node->num_child_) {
+      // MySQL: ALTER TABLE t ADD COLUMN c INT AS UDF func_name — physical column with UDF metadata
+      if (!lib::is_mysql_mode()) {
+        ret = OB_NOT_SUPPORTED;
+        LOG_USER_ERROR(OB_NOT_SUPPORTED, "AS UDF <routine_name>");
+        LOG_WARN("udf-backed column syntax is mysql only", K(ret));
+      } else {
+        ParseNode *udf_name_ref = node->children_[3];
+        ObString routine_name;
+        if (OB_ISNULL(udf_name_ref) || T_COLUMN_REF != udf_name_ref->type_
+            || COLUMN_DEF_NUM_CHILD != udf_name_ref->num_child_) {
+          ret = OB_ERR_UNEXPECTED;
+          LOG_WARN("invalid AS UDF routine name node", K(ret), KP(udf_name_ref));
+        } else if (OB_NOT_NULL(udf_name_ref->children_[0]) || OB_NOT_NULL(udf_name_ref->children_[1])) {
+          ret = OB_NOT_SUPPORTED;
+          LOG_USER_ERROR(OB_NOT_SUPPORTED, "qualified routine name in AS UDF");
+          LOG_WARN("qualified name not supported for AS UDF", K(ret));
+        } else if (OB_ISNULL(udf_name_ref->children_[2])) {
+          ret = OB_ERR_UNEXPECTED;
+          LOG_WARN("udf routine name ident null", K(ret));
+        } else if (OB_FAIL(resolve_column_name(routine_name, udf_name_ref->children_[2]))) {
+          LOG_WARN("resolve udf routine name failed", K(ret));
+        } else {
+          ObString full_name;
+          const ObString udf_prefix = ObString::make_string("UDF.");
+          const ObString parts[2] = { udf_prefix, routine_name };
+          if (OB_FAIL(ob_concat_string(*allocator_, full_name, 2, parts))) {
+            LOG_WARN("concat UDF routine default text failed", K(ret));
+          } else {
+            ObObj dv;
+            dv.set_varchar(full_name);
+            dv.set_collation_type(ObCharset::get_system_collation());
+            dv.set_collation_level(CS_LEVEL_COERCIBLE);
+            column.add_column_flag(GENERATED_COLUMN_UDF_EXPR);
+            if (OB_FAIL(column.set_cur_default_value(dv, false))) {
+              LOG_WARN("set cur default for udf-backed column failed", K(ret));
+            }
+          }
+        }
+      }
     } else if (is_external_table) {
       //mock generated column
       ObExternalFileFormat format;
@@ -3863,6 +3903,8 @@ int ObDDLResolver::resolve_column_definition(ObColumnSchemaV2 &column,
       if (OB_UNLIKELY(GEN_COLUMN_DEFINITION_NUM_CHILD == node->num_child_)) {
         // generated column with pos_column
         pos_node = node->children_[5];
+      } else if (OB_UNLIKELY(UDF_BACKED_COLUMN_DEFINITION_NUM_CHILD == node->num_child_)) {
+        pos_node = node->children_[5];
       } else {
         // normal column with pos_column
         pos_node = node->children_[3];
diff --git a/src/sql/resolver/ddl/ob_ddl_resolver.h b/src/sql/resolver/ddl/ob_ddl_resolver.h
index 0b865a74a54b..dad3bf24fb95 100644
--- a/src/sql/resolver/ddl/ob_ddl_resolver.h
+++ b/src/sql/resolver/ddl/ob_ddl_resolver.h
@@ -61,6 +61,7 @@ enum NUMCHILD {
   INDEX_NUM_CHILD = 5,
   CREATE_SYNONYM_NUM_CHILD = 7,
   GEN_COLUMN_DEFINITION_NUM_CHILD = 7, // generated column、identity column参数个数相同
+  UDF_BACKED_COLUMN_DEFINITION_NUM_CHILD = 6,
   IDEN_OPTION_DEFINITION_NUM_CHILD = 1
 };
 
-- 
2.17.0

