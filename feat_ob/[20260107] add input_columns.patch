From 73614b383448abf0582541138dcfc4986ddba219 Mon Sep 17 00:00:00 2001
From: He Su <yefengshuo.yfs@oceanbase.com>
Date: Wed, 7 Jan 2026 16:46:11 +0800
Subject: [PATCH 2/7] [add_column()][CREATE FUNCTION] add input_columns

---
 deps/oblib/src/lib/ob_define.h                   |  1 +
 .../inner_table/ob_inner_table_schema_def.py     |  2 ++
 src/share/schema/ob_routine_info.h               |  4 +++-
 src/share/schema/ob_routine_sql_service.cpp      | 13 ++++++++-----
 .../resolver/ddl/ob_create_routine_resolver.cpp  | 16 +++++++++++-----
 .../resolver/ddl/ob_create_routine_resolver.h    |  2 +-
 6 files changed, 26 insertions(+), 12 deletions(-)

diff --git a/deps/oblib/src/lib/ob_define.h b/deps/oblib/src/lib/ob_define.h
index 2716fa06c484..0e72de965395 100644
--- a/deps/oblib/src/lib/ob_define.h
+++ b/deps/oblib/src/lib/ob_define.h
@@ -328,6 +328,7 @@ const int64_t OB_MAX_CONSTRAINT_EXPR_LENGTH = 2048;
 const int64_t OB_MAX_TABLESPACE_NAME_LENGTH = 128;
 const int64_t OB_MAX_UDF_NAME_LENGTH = 64;
 const int64_t OB_MAX_UDF_PAYLOAD_SIZE = 16 * 1024L;
+const int64_t OB_MAX_UDF_INPUT_COLS_LENGTH = 1024;  // Max bytes for comma-separated input column names (string) of external routines.
 const int64_t OB_MAX_ASH_PL_NAME_LENGTH = 32;
 const int64_t OB_MAX_DL_NAME_LENGTH = 128;
 const int64_t OB_MAX_USER_NAME_LENGTH = 64; // Not compatible with Oracle (Oracle is 128), the logic is greater than when an error is reported
diff --git a/src/share/inner_table/ob_inner_table_schema_def.py b/src/share/inner_table/ob_inner_table_schema_def.py
index d0e5a8790f04..c5e097c89015 100755
--- a/src/share/inner_table/ob_inner_table_schema_def.py
+++ b/src/share/inner_table/ob_inner_table_schema_def.py
@@ -384,6 +384,7 @@ all_column_def = dict(
       ('skip_index_attr', 'int', 'false', '0'),
       ('lob_chunk_size', 'int', 'false', 'OB_DEFAULT_LOB_CHUNK_SIZE'),
       ('local_session_vars', 'longtext', 'true'),
+      ('routine_id', 'int', 'true')
     ],
 )
 
@@ -1611,6 +1612,7 @@ all_routine_def = dict(
       ('remote_mode', 'bool', 'true', 'false'),
       ('serialization_payload', 'varbinary:OB_MAX_UDF_PAYLOAD_SIZE', 'true'),
       ('serialization_format', 'varchar:32', 'true'),
+      ('input_columns', 'varchar:OB_MAX_UDF_INPUT_COLS_LENGTH', 'true'),
     ],
 )
 
diff --git a/src/share/schema/ob_routine_info.h b/src/share/schema/ob_routine_info.h
index 5d6af48d7053..07d1fce2b8e8 100644
--- a/src/share/schema/ob_routine_info.h
+++ b/src/share/schema/ob_routine_info.h
@@ -647,6 +647,8 @@ public:
   OB_INLINE bool is_remote() const { return SP_FLAG_REMOTE == (flag_ & SP_FLAG_REMOTE); }
   OB_INLINE void set_serialization_format(const common::ObString &format) { return deep_copy_str(format, serialization_format_); }
   OB_INLINE const common::ObString &get_serialization_format() const { return serialization_format_; }
+  OB_INLINE void set_input_columns(const common::ObString &columns) { return deep_copy_str(columns, input_columns_); }
+  OB_INLINE const common::ObString &get_input_columns() const { return input_columns_; }
 
   TO_STRING_KV(K_(tenant_id),
                K_(database_id),
@@ -702,7 +704,7 @@ private:
   common::ObString external_routine_url_;        // URL of external routine
   common::ObString external_routine_resource_;   // resource name of external routine
   common::ObString serialization_format_;          // serialization format of external routine
-  common::ObString serialization_checksum_;        // serialization checksum of external routine
+  common::ObString input_columns_;                  // input columns of external routine (args for python UDF)
 };
 }  // namespace schema
 }  // namespace share
diff --git a/src/share/schema/ob_routine_sql_service.cpp b/src/share/schema/ob_routine_sql_service.cpp
index 3a1624a39e42..e8f7c5c74c72 100644
--- a/src/share/schema/ob_routine_sql_service.cpp
+++ b/src/share/schema/ob_routine_sql_service.cpp
@@ -538,11 +538,14 @@ int ObRoutineSqlService::gen_routine_dml(
           || OB_FAIL(dml.add_column("external_routine_entry", ObHexEscapeSqlStr(routine_info.get_external_routine_entry())))
           || OB_FAIL(dml.add_column("external_routine_url", ObHexEscapeSqlStr(routine_info.get_external_routine_url())))
           || OB_FAIL(dml.add_column("external_routine_resource", ObHexEscapeSqlStr(routine_info.get_external_routine_resource())))
-          || OB_FAIL(dml.add_column("remote_mode", routine_info.is_remote()))
-          || (routine_info.is_remote()
-              && OB_FAIL(dml.add_column("serialization_payload", ObHexEscapeSqlStr(serialization_payload))))
-          || OB_FAIL(dml.add_column("serialization_format", ObHexEscapeSqlStr(routine_info.get_serialization_format())))) {
-        LOG_WARN("add column failed", K(ret));
+          || OB_FAIL(dml.add_column("remote_mode", routine_info.is_remote()))) {
+          LOG_WARN("add column failed", K(ret));
+      } else if (routine_info.is_remote()) {
+          if (OB_FAIL(dml.add_column("serialization_payload", ObHexEscapeSqlStr(serialization_payload)))
+           || OB_FAIL(dml.add_column("serialization_format", ObHexEscapeSqlStr(routine_info.get_serialization_format())))
+           || OB_FAIL(dml.add_column("input_columns", ObHexEscapeSqlStr(routine_info.get_input_columns())))){
+          LOG_WARN("add column failed", K(ret));
+          }
       }
     }
   }
diff --git a/src/sql/resolver/ddl/ob_create_routine_resolver.cpp b/src/sql/resolver/ddl/ob_create_routine_resolver.cpp
index 15a3b8b11c2b..dbab11761cb6 100644
--- a/src/sql/resolver/ddl/ob_create_routine_resolver.cpp
+++ b/src/sql/resolver/ddl/ob_create_routine_resolver.cpp
@@ -1330,11 +1330,13 @@ int ObCreateRoutineResolver::resolve_external_udf(const ParseNode &parse_tree,
       const ObString type_key = "type";
       const ObString file_key = "file";
       const ObString mode_key = "mode";
+      const ObString input_columns_key = "input_columns";
 
       ObString entry_name;
       ObString udf_type;
       ObString file;
       ObString mode;
+      ObString input_columns;
       bool is_py = false;
 
       CK (T_UDF_PROPERTY_LIST == property_node->type_);
@@ -1360,22 +1362,24 @@ int ObCreateRoutineResolver::resolve_external_udf(const ParseNode &parse_tree,
             file = value.trim();
           } else if (0 == key.case_compare(mode_key)) {
             mode = value.trim();
+          } else if (0 == key.case_compare(input_columns_key)) {
+            input_columns = value.trim();
           }
         }
       }
 
       if (OB_FAIL(ret)) {
         // do noting
-      } else if (entry_name.empty() || udf_type.empty() || file.empty() || mode.empty()) {
+      } else if (entry_name.empty() || udf_type.empty() || file.empty()) {
         ret = OB_INVALID_ARGUMENT;
-        LOG_WARN("invalid argument to create external UDF", K(ret), K(entry_name), K(udf_type), K(file), K(mode));
+        LOG_WARN("invalid argument to create external UDF", K(ret), K(entry_name), K(udf_type), K(file));
       } else if (OB_FAIL(routine_info.set_external_routine_entry(entry_name))) {
         LOG_WARN("failed to set external routine entry", K(ret), K(entry_name));
-      } else if (OB_FAIL(resolve_external_routine_type(udf_type, file, mode, routine_info))) {
-        LOG_WARN("failed to resolve external routine type", K(ret), K(udf_type), K(file), K(mode), K(routine_info));
+      } else if (OB_FAIL(resolve_external_routine_type(udf_type, file, mode, input_columns, routine_info))) {
+        LOG_WARN("failed to resolve external routine type", K(ret), K(udf_type), K(file), K(mode), K(input_columns), K(routine_info));
       }
 
-      LOG_INFO("finished to resolve external UDF", K(ret), K(entry_name), K(udf_type), K(file), K(mode), (routine_info));
+      LOG_INFO("finished to resolve external UDF", K(ret), K(entry_name), K(udf_type), K(file), K(mode), K(input_columns), (routine_info));
     } else {
       ret = OB_ERR_UNEXPECTED;
       LOG_WARN("unexpected parse_tree of external UDF",
@@ -1404,6 +1408,7 @@ int ObCreateRoutineResolver::resolve_external_udf(const ParseNode &parse_tree,
 int ObCreateRoutineResolver::resolve_external_routine_type(const ObString &udf_type,
                                                            const ObString &file,
                                                            const ObString &mode,
+                                                           const ObString &input_columns,
                                                            ObRoutineInfo &routine_info)
 {
   int ret = OB_SUCCESS;
@@ -1441,6 +1446,7 @@ int ObCreateRoutineResolver::resolve_external_routine_type(const ObString &udf_t
   if (0 == mode.case_compare(remote_mode)) {
     routine_info.set_is_remote();
     routine_info.set_serialization_format("cloudpickle");
+    routine_info.set_input_columns(input_columns);
   } 
 
   if (OB_FAIL(ret)) {
diff --git a/src/sql/resolver/ddl/ob_create_routine_resolver.h b/src/sql/resolver/ddl/ob_create_routine_resolver.h
index 3b3764580bb1..c6c49234cb92 100644
--- a/src/sql/resolver/ddl/ob_create_routine_resolver.h
+++ b/src/sql/resolver/ddl/ob_create_routine_resolver.h
@@ -87,7 +87,7 @@ private:
                         share::schema::ObRoutineParam &routine_param);
   int resolve_aggregate_body(const ParseNode *parse_node, share::schema::ObRoutineInfo &routine_info);
 
-  int resolve_external_routine_type(const ObString &udf_type, const ObString &file, const ObString &mode, share::schema::ObRoutineInfo &routine_info);
+  int resolve_external_routine_type(const ObString &udf_type, const ObString &file, const ObString &mode, const ObString &input_columns, share::schema::ObRoutineInfo &routine_info);
 };
 
 class ObCreateProcedureResolver: public ObCreateRoutineResolver
-- 
